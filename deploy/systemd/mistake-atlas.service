[Unit]
Description=Mistake Atlas Next.js Application
After=network.target postgresql.service

[Service]
Type=simple
User=mistake-atlas
Group=mistake-atlas
WorkingDirectory=/opt/mistake-atlas/current/frontend
Environment=NODE_ENV=production
EnvironmentFile=/opt/mistake-atlas/shared/app.env
ExecStart=/usr/bin/npm run start -- -p 3011
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/opt/mistake-atlas/data
UMask=0077

[Install]
WantedBy=multi-user.target
